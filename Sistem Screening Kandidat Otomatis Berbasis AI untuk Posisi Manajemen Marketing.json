      "id": "884d53ed-37e8-40f2-9372-c9f1572bb38b",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "UAJRu4At7mX1xpZd",
          "name": "Google Gemini(PaLM) Api account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const raw = item.json.text || item.json.output || '';\n\n  try {\n    // 1. Bersihkan pembungkus markdown ```json ... ```\n    const cleaned = raw\n      .replace(/```json/gi, '')\n      .replace(/```/g, '')\n      .trim();\n\n    // 2. Parse string menjadi objek JSON\n    const parsedData = JSON.parse(cleaned);\n\n    // 3. Masukkan ke item.json agar bisa dipanggil node berikutnya\n    item.json.ai_name = parsedData.candidate_name;\n    item.json.ai_exp = parsedData.years_of_experience;\n    item.json.ai_skills = Array.isArray(parsedData.top_skills)\n      ? parsedData.top_skills.join(', ')\n      : parsedData.top_skills;\n    item.json.ai_summary = parsedData.summary;\n    item.json.ai_score = Number(parsedData.score) || 0;\n    item.json.ai_rec = parsedData.hiring_recommendation;\n\n  } catch (error) {\n    // Fallback: workflow tidak crash, error dicatat untuk debugging\n    item.json.error = error.message;\n    item.json.raw_output = raw;\n    item.json.ai_name = 'Gagal parsing';\n    item.json.ai_exp = '-';\n    item.json.ai_skills = '-';\n    item.json.ai_summary = 'Output AI bukan JSON valid. Cek raw_output.';\n    item.json.ai_score = 0;\n    item.json.ai_rec = '-';\n  }\n\n  return item;\n});"
      },
