    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  // Nama key binary bisa berbeda-beda, jadi ambil key pertama secara otomatis\n  const binaryKey = Object.keys(item.binary)[0];\n  const binaryData = item.binary[binaryKey];\n\n  // Ambil string Base64 mentah dan simpan metadata\n  item.json.cv_base64 = binaryData.data;\n  item.json.cv_filename = binaryData.fileName;\n  item.json.binary_key = binaryKey;\n\n  // Timestamp waktu lokal WIB (Luxon)\n  item.json.submitted_at =\n    DateTime.now().setZone('Asia/Jakarta').toFormat('dd-MM-yyyy HH:mm:ss') + ' WIB';\n\n  results.push(item);\n}\n\nreturn results;"
      },
